---

import { SITE_TITLE } from '../consts';

import HeaderLink from './HeaderLink.astro';

---

<header class="site-header">

  <nav aria-label="Main navigation">

    <div class="wordmark"><a href="/">{SITE_TITLE}</a></div>

    <div class="internal-links">

      <HeaderLink href="/">Home</HeaderLink>

      <HeaderLink href="/blog">Blog</HeaderLink>

      <HeaderLink href="/about">About</HeaderLink>

    </div>

    <div class="social-links">

      <a href="https://www.tiktok.com/@just_okinawa" target="_blank" rel="noopener noreferrer">

        <span class="sr-only">TikTok</span>

        <svg aria-hidden="true" viewBox="0 0 24 24" width="28" height="28"><path fill="currentColor" d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.77a4.85 4.85 0 0 1-1.01-.08z"/></svg>

      </a>

      <a href="https://www.instagram.com/just_okinawa" target="_blank" rel="noopener noreferrer">

        <span class="sr-only">Instagram</span>

        <svg aria-hidden="true" viewBox="0 0 24 24" width="28" height="28"><path fill="currentColor" d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>

      </a>

      <a href="https://www.youtube.com/@JustOkinawaJP" target="_blank" rel="noopener noreferrer">

        <span class="sr-only">YouTube</span>

        <svg aria-hidden="true" viewBox="0 0 24 24" width="28" height="28"><path fill="currentColor" d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>

      </a>

    </div>

  </nav>

</header>

<style>
  .site-header { padding: 0 var(--gutter); border-bottom: 1px solid var(--line); background: var(--bg); }
  nav { max-width: 1440px; min-height: 96px; margin: auto; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .wordmark { flex-shrink: 0; font-size: 18px; font-weight: 750; letter-spacing: -.04em; text-transform: uppercase; }
  .wordmark a { color: var(--text); text-decoration: none; }
  .internal-links, .social-links { display: flex; align-items: center; gap: 20px; }
  .internal-links :global(a) { display: inline-flex; align-items: center; min-height: 44px; padding: 0; border: 0; color: var(--muted); font-size: 12px; text-decoration: none; }
  .internal-links :global(a.active), .internal-links :global(a:hover) { color: var(--text); }
  .internal-links :global(a.active) { text-decoration: underline; text-underline-offset: 7px; text-decoration-thickness: 1px; }
  .social-links { gap: 4px; }
  .social-links a { display: grid; place-items: center; width: 44px; height: 44px; color: var(--muted); }
  .social-links a:hover { color: var(--text); }
  .social-links svg { width: 16px; height: 16px; }
  @media (max-width: 640px) {
    nav { min-height: 100px; display: grid; grid-template-columns: 1fr auto; gap: 0 12px; padding: 12px 0; }
    .wordmark { font-size: 16px; }
    .internal-links { grid-row: 2; grid-column: 1 / -1; gap: 26px; }
    .social-links a { width: 36px; height: 44px; }
  }
</style>
