---
import {getCollection} from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import PostCard from '../../components/PostCard.astro';
import {destinations} from '../../data/destinations';
import {published,meta} from '../../lib/editorial';
export function getStaticPaths(){return destinations.map(destination=>({params:{island:destination.id},props:{destination}}));}
const {destination:d}=Astro.props;
const posts=(await getCollection('blog')).filter(p=>published(p)&&meta(p).destination===d.id).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---
<SiteLayout title={`${d.name} — Just Okinawa`} description={d.description}><section class="destination-hero"><div class="destination-copy"><a class="eyebrow" href="/#islands">← EXPLORE THE ISLANDS</a><h1>{d.name}<br/><em>{d.jp}</em></h1><p>{d.intro}</p><a class="button" href="#island-stories">Stories from {d.short} <span aria-hidden="true">↓</span></a></div>{d.image?<img src={d.image} alt={d.alt} width="1000" height="900" fetchpriority="high"/>:<div class="map-no-photo"><span>{d.jp}</span></div>}</section><section class="wrap destination-details"><div><span class="eyebrow">YOUR KIND OF ISLAND</span><h2>{d.tag}</h2><p>{d.description}</p><ul>{d.highlights.map(h=><li>{h}</li>)}</ul></div><div><h2>Before you go.</h2><p>{d.access}</p><a class="text-link" href={d.source} target="_blank" rel="noopener noreferrer">Official destination guide <span aria-hidden="true">↗</span></a><p class="small-note">Check current transport, opening hours and local guidance before travelling.</p></div></section><section class="wrap content-section" id="island-stories"><div class="section-top"><h2>Stories from <em>{d.short}.</em></h2><a class="text-link" href={`/blog/?island=${d.id}`}>All {d.short} stories ↗</a></div><div class="post-grid">{posts.slice(0,6).map(post=><PostCard post={post}/>)}</div>{!posts.length&&<p>Our {d.short} journal is still growing. The official guide above is a good place to start.</p>}</section></SiteLayout>
