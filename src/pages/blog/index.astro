---
import {getCollection} from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import PostCard from '../../components/PostCard.astro';
import {destinations,experiences} from '../../data/destinations';
import {published,meta,publicationMonth} from '../../lib/editorial';
const posts=(await getCollection('blog')).filter(published).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const months=[...new Set(posts.map(p=>publicationMonth(p.data.pubDate)))];
---
<SiteLayout title="The Journal — Just Okinawa" description="Fresh stories from Okinawa. Explore by island, experience or month, and find a little inspiration for your next journey."><div class="wrap"><header class="page-intro"><span class="eyebrow">EVERYDAY MOMENTS. ISLAND STORIES.</span><h1>The island <em>journal.</em></h1><p>A place to return to. Fresh stories, quiet discoveries, and a little inspiration for your next journey.</p></header><section class="content-section" aria-label="Browse articles"><form class="filter-bar" id="journal-filters" role="search"><label>Search the journal<input type="search" name="q" id="search" placeholder="Try a place, a flavor, a feeling…"/></label><label>Island<select name="island" id="island"><option value="">All islands</option>{destinations.map(d=><option value={d.id}>{d.name}</option>)}</select></label><label>Experience<select name="experience" id="experience"><option value="">All experiences</option>{experiences.map(e=><option value={e.id}>{e.label}</option>)}</select></label><label>Month<select name="month" id="month"><option value="">Any time</option>{months.map(m=><option value={m}>{new Date(m+'-01T00:00:00Z').toLocaleDateString('en',{month:'long',year:'numeric',timeZone:'UTC'})}</option>)}</select></label></form><p class="results-count" id="results-count" role="status" aria-live="polite">{posts.length} stories · Latest first</p><div class="post-grid" id="journal-results">{posts.slice(0,12).map(post=><PostCard post={post}/>)}</div><p id="empty-state" class="empty-state" hidden>No stories match yet. Try another island or a broader search.</p><div class="pagination" id="pagination" hidden><button id="previous" type="button">← Previous</button><span id="page-label"></span><button id="next" type="button">Next →</button></div><noscript><p>All stories:</p><ul>{posts.map(p=><li><a href={`/blog/${p.id}/`}>{p.data.title}</a></li>)}</ul></noscript><template id="article-catalog">{posts.map(post=><div data-search={`${post.data.title} ${post.data.description}`.toLowerCase()} data-destination={meta(post).destination??''} data-experiences={(meta(post).experiences??[]).join(' ')} data-month={publicationMonth(post.data.pubDate)}><PostCard post={post}/></div>)}</template></section></div></SiteLayout>
<script>
 const form=document.querySelector<HTMLFormElement>('#journal-filters')!;
 const controls=['q','island','experience','month'].map(name=>form.elements.namedItem(name) as HTMLInputElement|HTMLSelectElement);
 const catalog=Array.from(document.querySelector<HTMLTemplateElement>('#article-catalog')!.content.children) as HTMLElement[];
 const results=document.querySelector<HTMLElement>('#journal-results')!;
 const count=document.querySelector<HTMLElement>('#results-count')!;
 const pagination=document.querySelector<HTMLElement>('#pagination')!;
 const prev=document.querySelector<HTMLButtonElement>('#previous')!;
 const next=document.querySelector<HTMLButtonElement>('#next')!;
 let current=1;
 function render(updateUrl=true){
  const [query,island,experience,month]=controls.map(c=>c.value.trim().toLowerCase());
  const list=catalog.filter(p=>(!query||p.dataset.search?.includes(query))&&(!island||p.dataset.destination===island)&&(!experience||p.dataset.experiences?.split(' ').includes(experience))&&(!month||p.dataset.month===month));
  const total=Math.max(1,Math.ceil(list.length/12));current=Math.max(1,Math.min(total,current));
  results.replaceChildren(...list.slice((current-1)*12,current*12).map(p=>p.firstElementChild!.cloneNode(true)));
  count.textContent=`${list.length} ${list.length===1?'story':'stories'} · Latest first`;
  document.querySelector<HTMLElement>('#empty-state')!.hidden=list.length>0;
  pagination.hidden=total<=1;prev.disabled=current===1;next.disabled=current===total;
  document.querySelector('#page-label')!.textContent=`${current} / ${total}`;
  if(updateUrl){const params=new URLSearchParams();controls.forEach(c=>{if(c.value)params.set(c.name,c.value);});if(current>1)params.set('page',String(current));history.replaceState(null,'',location.pathname+(params.size?'?'+params.toString():''));}
 }
 function fromURL(){const params=new URLSearchParams(location.search);controls.forEach(c=>c.value=params.get(c.name)??'');current=Number(params.get('page'))||1;render(false);}
 form.addEventListener('submit',e=>{e.preventDefault();current=1;render();});
 let timer:ReturnType<typeof setTimeout>;
 form.addEventListener('input',()=>{clearTimeout(timer);timer=setTimeout(()=>{current=1;render();},120);});
 prev.addEventListener('click',()=>{current--;render();form.scrollIntoView({block:'start'});});
 next.addEventListener('click',()=>{current++;render();form.scrollIntoView({block:'start'});});
 window.addEventListener('popstate',fromURL);fromURL();
</script>
