---
import { Image } from 'astro:assets';

import { getCollection } from 'astro:content';

import BaseHead from '../../components/BaseHead.astro';

import Footer from '../../components/Footer.astro';

import FormattedDate from '../../components/FormattedDate.astro';

import Header from '../../components/Header.astro';

import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(

  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),

);
---
<!doctype html>
<html lang="en">
  <head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /></head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" class="editorial-main">
      <div class="archive shell">
        <header class="archive-intro"><span class="eyebrow">The journal / Okinawa, Japan</span><h1>Island stories.</h1><p>Places to linger. Things to taste.<br />A little closer to everyday Okinawa.</p></header>
        <section aria-label="All articles">
          <div class="section-heading"><span class="eyebrow">All stories</span><span class="eyebrow">{String(posts.length).padStart(2, '0')} entries</span></div>
          <ul class="archive-grid">
            {posts.map((post) => (
              <li class="archive-card">
                <a href={`/blog/${post.id}/`}>
                  <div class="archive-media">{post.data.heroImage ? <Image width={1200} height={750} src={post.data.heroImage} alt="" loading="lazy" /> : <span class="eyebrow">Just Okinawa / Journal</span>}</div>
                  <div class="archive-caption"><p class="eyebrow date"><FormattedDate date={post.data.pubDate} /></p><h2>{post.data.title}</h2><p class="description">{post.data.description}</p><span class="read">Read the story <span aria-hidden="true">↗</span></span></div>
                </a>
              </li>
            ))}
          </ul>
          {posts.length === 0 && <p class="archive-empty">Our first island stories are on their way.</p>}
        </section>
      </div>
    </main>
    <Footer />
  </body>
</html>
<style>
  .archive { padding-block: clamp(48px, 8vw, 120px) 100px; }
  .archive-intro { margin-bottom: 64px; }
  .archive-intro .eyebrow { color: var(--muted); margin-bottom: 28px; }
  .archive-intro h1 { font-size: clamp(52px, 9vw, 144px); line-height: 1; }
  .archive-intro > p { color: var(--muted); margin: 24px 0 0; font-size: 16px; }
  .archive-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 64px 40px; list-style: none; margin: 16px 0 0; padding: 0; }
  .archive-card a { display: block; height: 100%; color: var(--text); text-decoration: none; }
  .archive-media { display: grid; place-items: center; aspect-ratio: 8/5; overflow: hidden; background: var(--surface); }
  .archive-media img { width: 100%; height: 100%; object-fit: cover; transition: transform .65s ease; }
  .archive-card a:hover img { transform: scale(1.035); }
  .archive-caption { padding-top: 22px; }
  .date { color: var(--muted); margin-bottom: 14px; }
  .archive-caption h2 { font-size: clamp(28px, 3.5vw, 46px); }
  .description { color: var(--muted); font-size: 14px; margin: 18px 0; max-width: 470px; }
  .read { font-size: 12px; }
  .read span { display: inline-block; margin-left: 18px; transition: transform .25s; }
  a:hover .read span { transform: translate(3px, -3px); }
  .archive-card:first-child { grid-column: 1 / -1; padding-bottom: 48px; border-bottom: 1px solid var(--line); }
  .archive-card:first-child a { display: grid; grid-template-columns: 1.5fr 1fr; gap: 48px; align-items: center; }
  .archive-card:first-child .archive-caption { padding: 0; }
  .archive-empty { padding-block: 40px; color: var(--muted); }
  @media (max-width: 760px) {
    .archive-grid { gap: 42px 24px; }
    .archive-card:first-child a { display: block; }
    .archive-card:first-child .archive-caption { padding-top: 22px; }
  }
  @media (max-width: 540px) { .archive-grid { grid-template-columns: 1fr; } .archive-intro { margin-bottom: 40px; } }
</style>
