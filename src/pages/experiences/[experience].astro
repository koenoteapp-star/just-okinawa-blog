---
import {getCollection} from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import PostCard from '../../components/PostCard.astro';
import {experiences} from '../../data/destinations';
import {published,meta} from '../../lib/editorial';
export function getStaticPaths(){return experiences.map(experience=>({params:{experience:experience.id},props:{experience}}));}
const {experience:e}=Astro.props;
const posts=(await getCollection('blog')).filter(p=>published(p)&&meta(p).experiences?.includes(e.id)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---
<SiteLayout title={`${e.label} — Just Okinawa`} description={e.description}><section class="destination-hero"><div class="destination-copy"><a class="eyebrow" href="/#experiences">← FIND YOUR FEELING</a><h1>{e.name}</h1><p>{e.description}</p><a class="button" href="#experience-stories">Explore the stories <span aria-hidden="true">↓</span></a></div><img src={e.image} alt={e.label} width="1000" height="900" fetchpriority="high"/></section><section class="wrap journal-section" id="experience-stories"><div class="section-top"><h2>{e.label}</h2><a class="text-link" href={`/blog/?experience=${e.id}`}>All related stories ↗</a></div><div class="post-grid">{posts.slice(0,9).map(post=><PostCard post={post}/>)}</div>{!posts.length&&<p>Fresh stories are on their way. <a href="/plan/">Start planning your trip.</a></p>}</section></SiteLayout>
