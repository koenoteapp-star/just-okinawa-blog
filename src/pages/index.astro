---
import { Image } from 'astro:assets';

import { getCollection } from 'astro:content';

import BaseHead from '../components/BaseHead.astro';

import Footer from '../components/Footer.astro';

import Header from '../components/Header.astro';

import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(

  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()

);

const [hero, ...rest] = posts;

const secondary = rest.slice(0, 2);
---
<!doctype html>
<html lang="en">
  <head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /></head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" class="editorial-main">
      <section class="opening shell" aria-label="Just Okinawa introduction">
        <p class="eyebrow">An independent island journal</p>
        <p class="opening-note">Okinawa, Japan <span aria-hidden="true">↘</span></p>
      </section>
      {hero ? (
        <section class="hp-hero" aria-labelledby="hero-title">
          {hero.data.heroImage && <Image src={hero.data.heroImage} alt={hero.data.title} width={1600} height={900} class="hp-hero__img" loading="eager" fetchpriority="high" />}
          <div class="hp-hero__overlay">
            <div class="shell hp-hero__content">
              <span class="eyebrow">01 / Featured story</span>
              <h1 id="hero-title">{hero.data.title}</h1>
              <div class="hp-hero__bottom">
                <p>{hero.data.description}</p>
                <a href={`/blog/${hero.id}/`} class="text-link">Read the story <span aria-hidden="true">↗</span></a>
              </div>
            </div>
          </div>
        </section>
      ) : (
        <section class="empty shell"><span class="eyebrow">Just Okinawa</span><h1>A slower side<br />of Japan.</h1><p>Stories from the islands. Coming soon.</p></section>
      )}
      <section class="journal shell" aria-labelledby="journal-title">
        <div class="section-heading"><h2 id="journal-title">From the islands.</h2><a href="/blog" class="text-link">All stories <span aria-hidden="true">↗</span></a></div>
        <div class="hp-grid">
          {secondary.map((post, i) => (
            <article class="hp-card">
              <a href={`/blog/${post.id}/`} class="hp-card__link">
                <div class="hp-card__media">
                  {post.data.heroImage ? <Image src={post.data.heroImage} alt="" width={800} height={500} class="hp-card__img" loading="lazy" /> : <span class="eyebrow">Just Okinawa / Journal</span>}
                  <span class="card-number" aria-hidden="true">0{i + 2}</span>
                </div>
                <div class="hp-card__caption"><h3>{post.data.title}</h3><span aria-hidden="true">↗</span></div>
                <p>{post.data.description}</p>
              </a>
            </article>
          ))}
        </div>
        {secondary.length === 0 && <p class="quiet">More island stories are on their way.</p>}
      </section>
      <section class="island-note shell" aria-labelledby="island-title">
        <span class="eyebrow">A different rhythm</span>
        <div><h2 id="island-title">Less itinerary.<br />More island.</h2><p>Beyond the postcard: everyday places, local flavors, and the quiet moments in between.</p><a href="/about" class="text-link">About the journal <span aria-hidden="true">↗</span></a></div>
      </section>
    </main>
    <Footer />
  </body>
</html>
<style>
  .opening { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding-block: 22px; }
  .opening p { margin: 0; }
  .opening-note { font-size: 11px; color: var(--muted); }
  .opening-note span { margin-left: 28px; }
  .hp-hero { position: relative; isolation: isolate; display: grid; min-height: min(800px, 85svh); background: #252d26; }
  .hp-hero__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hp-hero__overlay { position: relative; display: flex; align-items: end; background: linear-gradient(180deg, #070c0830 0%, #070c0850 28%, #070c08dd 100%); }
  .hp-hero__content { padding-block: clamp(40px, 6vw, 88px); }
  .hp-hero .eyebrow { color: #eee; margin-bottom: 32px; }
  .hp-hero h1 { max-width: 1100px; font-size: clamp(44px, 6.5vw, 104px); line-height: .99; letter-spacing: -.055em; text-wrap: balance; }
  .hp-hero__bottom { display: flex; align-items: end; justify-content: space-between; gap: 40px; margin-top: 32px; }
  .hp-hero__bottom p { max-width: 490px; margin: 0; font-size: 15px; color: #e0e3d8; }
  .hp-hero__bottom a { flex-shrink: 0; }
  .journal { padding-block: 80px; }
  .hp-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; margin-top: 14px; }
  .hp-card:nth-child(2) { margin-top: 88px; }
  .hp-card__link { color: var(--text); text-decoration: none; }
  .hp-card__media { position: relative; display: grid; place-items: center; aspect-ratio: 8/5; overflow: hidden; background: var(--surface); }
  .hp-card__img { width: 100%; height: 100%; object-fit: cover; transition: transform .65s ease; }
  .hp-card__link:hover .hp-card__img { transform: scale(1.035); }
  .card-number { position: absolute; top: 16px; left: 16px; padding: 3px 10px; background: #101311bf; font-size: 10px; }
  .hp-card__caption { display: flex; justify-content: space-between; gap: 24px; margin-top: 22px; }
  .hp-card__caption h3 { font-size: clamp(26px, 3vw, 42px); }
  .hp-card__link p { color: var(--muted); font-size: 14px; margin: 16px 0 0; max-width: 460px; }
  .island-note { border-top: 1px solid var(--line); padding-block: 72px 104px; display: grid; grid-template-columns: 1fr 2fr; gap: 40px; }
  .island-note > .eyebrow { color: var(--muted); }
  .island-note h2 { font-size: clamp(48px, 7.5vw, 112px); line-height: 1; }
  .island-note p { margin: 30px 0 20px; max-width: 440px; color: var(--muted); font-size: 16px; }
  .empty { padding-block: 70px; }
  .empty h1 { margin-block: 30px; }
  .quiet { color: var(--muted); font-size: 14px; }
  @media (max-width: 640px) {
    .opening-note { display: none; }
    .hp-hero { min-height: 620px; min-height: 78svh; }
    .hp-hero__bottom { display: block; }
    .hp-hero__bottom a { margin-top: 24px; }
    .hp-grid { grid-template-columns: 1fr; gap: 42px; }
    .hp-card:nth-child(2) { margin-top: 0; }
    .journal { padding-block: 48px; }
    .island-note { grid-template-columns: 1fr; padding-block: 40px 64px; gap: 28px; }
  }
</style>
