---
import {getCollection} from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import IslandMap from '../components/IslandMap.astro';
import PostCard from '../components/PostCard.astro';
import {experiences} from '../data/destinations';
import {published} from '../lib/editorial';
const posts=(await getCollection('blog')).filter(published).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const latest=posts.slice(0,6);
---
<SiteLayout title="Just Okinawa — Find your island rhythm" description="Discover Okinawa through extraordinary places and everyday moments. Explore the islands, find your kind of experience, and plan a slower journey." overlay>
<section class="hero"><img class="hero-image" src="/images/welcome.webp" srcset="/images/welcome-small.webp 900w, /images/welcome.webp 1920w" sizes="100vw" width="2000" height="1333" alt="White sand and turquoise water at Furuzamami Beach, Zamami, Okinawa" fetchpriority="high"/><div class="hero-shade"></div><div class="hero-content wrap"><span class="eyebrow">A DIFFERENT SIDE OF JAPAN</span><h1>Somewhere<br/>you can just <em>be.</em></h1><p>Extraordinary islands. Everyday magic.<br/>Find your own Okinawa.</p><a class="button button-light" href="#islands">Find your island <span aria-hidden="true">↗</span></a></div><div class="hero-bottom wrap"><span>ZAMAMI ISLAND, OKINAWA</span><a href="#intro">A slower story starts here <span aria-hidden="true">↓</span></a><span class="hero-japanese" lang="ja">ありのままの、沖縄。</span></div></section>
<section class="intro wrap" id="intro"><div class="intro-label"><span class="eyebrow">WELCOME TO JUST OKINAWA</span><span lang="ja">島時間</span></div><div class="intro-copy"><h2>Not just a place.<br/><em>A different pace.</em></h2><p>Past the postcard-blue sea, there’s another Okinawa. A quiet lane. A little neighborhood kitchen. An afternoon that asks nothing of you.</p><p>Come for the islands. Stay for the way they make you feel.</p><a class="text-link" href="/about/">Meet Just Okinawa <span aria-hidden="true">↗</span></a></div><figure class="intro-photo"><img src="/images/taketomi.webp" alt="Pink flowers beside a traditional red-tiled roof on Taketomi Island" width="700" height="900" loading="lazy"/><figcaption>THE BEAUTY IS IN THE EVERYDAY.</figcaption></figure></section>
<IslandMap/>
<section class="experiences-section wrap" id="experiences"><div class="section-top"><div><span class="eyebrow">02 — FOLLOW YOUR FEELING</span><h2>What brings <em>you here?</em></h2></div><p>A plan is optional.<br/>A little curiosity is all you need.</p></div><div class="experience-grid">{experiences.map((e,i)=><a class="experience-card" href={`/experiences/${e.id}/`}><img src={e.image} alt={e.label} width="640" height="900" loading="lazy"/><span class="experience-number">0{i+1}</span><div><span class="eyebrow">{e.label}</span><h3>{e.name}</h3><span class="experience-arrow" aria-hidden="true">↗</span></div></a>)}</div></section>
<section class="trip-band"><div class="wrap trip-band-inner"><div><span class="eyebrow">03 — MAKE IT YOURS</span><h2>A few days.<br/><em>A world away.</em></h2><p>Start with one island, a little room in your itinerary, and a few places you can’t wait to see.</p><a class="button" href="/plan/">Start planning <span aria-hidden="true">↗</span></a></div><div class="trip-list"><a href="/plan/#first-visit"><span>01 / YOUR FIRST VISIT</span><h3>A little of everything.</h3><p>Main island · A flexible 3-day starting point</p><b aria-hidden="true">↗</b></a><a href="/plan/#slow-islands"><span>02 / SLOW ISLAND DAYS</span><h3>Less rushing. More living.</h3><p>Yaeyama · A flexible 5-day starting point</p><b aria-hidden="true">↗</b></a><a href="/plan/#essentials"><span>03 / BEFORE YOU GO</span><h3>The practical little things.</h3><p>Getting here, getting around, and when to visit</p><b aria-hidden="true">↗</b></a></div></div></section>
<section class="journal-section wrap" id="journal"><div class="section-top"><div><span class="eyebrow">04 — THE ISLAND JOURNAL</span><h2>Fresh from <em>the islands.</em></h2></div><a class="text-link" href="/blog/">Explore the journal <span aria-hidden="true">↗</span></a></div><div class="post-grid">{latest.map(post=><PostCard post={post}/>)}</div>{!latest.length&&<p>The first stories are on their way. In the meantime, explore the islands.</p>}</section>
<section class="closing"><img src="/images/night.webp" width="1600" height="1000" alt="Stars over Taketomi in Okinawa" loading="lazy"/><div class="closing-copy"><span class="eyebrow">TAKE A LITTLE OKINAWA WITH YOU</span><h2>Some places stay<br/><em>with you.</em></h2><p>A little island life, wherever you are.</p><div class="closing-socials"><a href="https://www.instagram.com/just_okinawa" target="_blank" rel="noopener noreferrer">Instagram ↗</a><a href="https://www.tiktok.com/@just_okinawa" target="_blank" rel="noopener noreferrer">TikTok ↗</a><a href="https://www.youtube.com/@JustOkinawaJP" target="_blank" rel="noopener noreferrer">YouTube ↗</a></div></div></section>
</SiteLayout>
