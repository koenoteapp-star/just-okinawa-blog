---
import { Image } from 'astro:assets';

import type { CollectionEntry } from 'astro:content';

import BaseHead from '../components/BaseHead.astro';

import Footer from '../components/Footer.astro';

import FormattedDate from '../components/FormattedDate.astro';

import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, affiliateLinks } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head><BaseHead title={title} description={description} /></head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" class="editorial-main">
      <article>
        {heroImage ? (
          <header class="post-hero">
            <Image width={1400} height={800} src={heroImage} alt={title} loading="eager" fetchpriority="high" />
            <div class="post-hero-overlay"><div class="shell post-hero-text"><a href="/blog" class="eyebrow back-link">← The journal</a><div class="date"><FormattedDate date={pubDate} />{updatedDate && <> · Updated <FormattedDate date={updatedDate} /></>}</div><h1>{title}</h1></div></div>
          </header>
        ) : (
          <header class="post-title-plain shell"><a href="/blog" class="eyebrow back-link">← The journal</a><div class="date"><FormattedDate date={pubDate} /></div><h1>{title}</h1></header>
        )}
        <div class="post-body"><div class="prose"><slot /></div></div>
        {affiliateLinks && (
          <aside class="affiliate-box" aria-labelledby="trip-heading">
            <span class="eyebrow">For your next chapter</span>
            <h2 id="trip-heading">Plan your trip.</h2>
            <div class="affiliate-links">
              {affiliateLinks.booking && <a href={affiliateLinks.booking} target="_blank" rel="sponsored nofollow noopener noreferrer" class="affiliate-link booking">Hotels <span aria-hidden="true">↗</span></a>}
              {affiliateLinks.viator && <a href={affiliateLinks.viator} target="_blank" rel="sponsored nofollow noopener noreferrer" class="affiliate-link viator">Book a tour <span aria-hidden="true">↗</span></a>}
              {affiliateLinks.amazon && <a href={affiliateLinks.amazon} target="_blank" rel="sponsored nofollow noopener noreferrer" class="affiliate-link amazon">Amazon <span aria-hidden="true">↗</span></a>}
              {affiliateLinks.youtubeVideo && <a href={affiliateLinks.youtubeVideo} target="_blank" rel="noopener noreferrer" class="affiliate-link youtube">Watch <span aria-hidden="true">↗</span></a>}
            </div>
          </aside>
        )}
        <nav class="post-end" aria-label="Article navigation"><a href="/blog" class="text-link">Back to all stories <span aria-hidden="true">↗</span></a></nav>
      </article>
    </main>
    <Footer />
  </body>
</html>
<style>
  .post-hero { position: relative; display: grid; min-height: 620px; min-height: min(760px, 82svh); background: #252d26; }
  .post-hero > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .post-hero-overlay { position: relative; display: flex; align-items: end; background: linear-gradient(180deg, #070c0830, #070c0880 45%, #070c08e6); }
  .post-hero-text { padding-block: 56px; }
  .back-link { color: var(--text); text-decoration: none; display: inline-flex; align-items: center; min-height: 44px; margin-bottom: 36px; }
  .back-link:hover { text-decoration: underline; }
  .date { color: #d0d4c8; font-size: 11px; margin-bottom: 20px; }
  h1 { max-width: 1080px; font-size: clamp(42px, 6.2vw, 92px); line-height: 1.03; text-wrap: balance; }
  .post-title-plain { padding-block: 64px; border-bottom: 1px solid var(--line); }
  .post-body { width: min(100% - 2 * var(--gutter), 700px); margin: auto; padding-block: 64px 32px; }
  .prose { color: #d4d8ce; font-size: clamp(17px, 1.5vw, 19px); line-height: 1.85; overflow-wrap: anywhere; }
  .prose :global(p) { margin: 0 0 1.65em; }
  .prose :global(h2) { font-size: clamp(30px, 4vw, 44px); margin: 1.8em 0 .7em; }
  .prose :global(h3) { font-size: clamp(24px, 3vw, 30px); margin: 1.6em 0 .7em; }
  .prose :global(h4) { margin: 1.5em 0 .7em; }
  .prose :global(strong) { color: var(--text); }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.4em; margin-block: 1.5em; }
  .prose :global(li) { margin-block: .4em; }
  .prose :global(img) { margin-block: 2.5em; width: 100%; height: auto; }
  .prose :global(figure) { margin: 2.5em 0; }
  .prose :global(figure img) { margin: 0; }
  .prose :global(figcaption) { font-size: 12px; color: var(--muted); margin-top: 12px; }
  .prose :global(blockquote) { font-size: clamp(23px, 3vw, 30px); line-height: 1.5; letter-spacing: -.02em; }
  .prose :global(table) { display: block; overflow-x: auto; font-size: 14px; }
  .prose :global(iframe), .prose :global(video) { max-width: 100%; }
  .affiliate-box { width: min(100% - 2 * var(--gutter), 900px); margin: 24px auto 0; padding: clamp(24px, 5vw, 48px); background: var(--surface); border: 1px solid var(--line); }
  .affiliate-box > .eyebrow { color: var(--muted); margin-bottom: 18px; }
  .affiliate-box h2 { font-size: clamp(32px, 4vw, 48px); }
  .affiliate-links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .affiliate-link { display: flex; align-items: center; justify-content: space-between; gap: 32px; padding: 13px 18px; min-height: 48px; border: 1px solid #67715d; color: var(--text); text-decoration: none; font-size: 12px; transition: background .2s, color .2s; }
  .affiliate-link:hover { background: var(--accent); color: var(--bg); }
  .post-end { width: min(100% - 2 * var(--gutter), 700px); margin: auto; padding-block: 48px 80px; }
  @media (max-width: 640px) {
    .post-hero-text { padding-block: 40px; }
    .post-body { padding-top: 40px; }
    .affiliate-links { flex-direction: column; }
  }
</style>
