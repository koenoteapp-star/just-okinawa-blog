---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, affiliateLinks } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			/* Hero */
			.post-hero {
				position: relative;
				width: 100%;
				height: 60vh;
				min-height: 360px;
				overflow: hidden;
			}
			.post-hero img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				border-radius: 0;
				display: block;
			}
			.post-hero-overlay {
				position: absolute;
				inset: 0;
				background: linear-gradient(to top, rgba(0,0,0,0.65) 0%, rgba(0,0,0,0.1) 60%, transparent 100%);
				display: flex;
				align-items: flex-end;
			}
			.post-hero-text {
				padding: 2.5rem 3rem;
				color: white;
				max-width: 820px;
			}
			.post-hero-text .date {
				font-size: 0.8rem;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				opacity: 0.7;
				margin-bottom: 0.6em;
				color: white;
			}
			.post-hero-text h1 {
				font-size: clamp(1.6rem, 3.5vw, 2.8rem);
				color: white;
				margin: 0;
				line-height: 1.2;
			}

			/* No hero fallback */
			.post-title-plain {
				max-width: 720px;
				margin: 3em auto 0;
				padding: 0 1.5em;
				text-align: center;
			}
			.post-title-plain .date {
				font-size: 0.85rem;
				color: rgb(var(--gray));
				letter-spacing: 0.08em;
				text-transform: uppercase;
			}
			.post-title-plain h1 {
				margin: 0.4em 0 0;
				font-size: clamp(1.8rem, 4vw, 3rem);
				line-height: 1.15;
			}

			/* Body */
			.prose {
				width: 680px;
				max-width: calc(100% - 2em);
				margin: 3em auto;
				padding: 0 1em;
				color: rgb(var(--gray-dark));
				font-size: 1.05rem;
				line-height: 1.8;
			}
			.prose hr {
				margin: 2.5em 0;
			}

			/* Affiliate box */
			.affiliate-box {
				width: 680px;
				max-width: calc(100% - 2em);
				margin: 0 auto 4em;
				padding: 1.5em 2em;
				background: linear-gradient(135deg, #f0fafe 0%, #e8f8ff 100%);
				border-left: 4px solid var(--accent);
				border-radius: 0 12px 12px 0;
			}
			.affiliate-box h3 {
				font-size: 0.8rem;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				color: var(--accent-dark);
				margin: 0 0 1em 0;
			}
			.affiliate-links {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6em;
			}
			.affiliate-link {
				display: inline-flex;
				align-items: center;
				gap: 0.35em;
				padding: 0.55em 1.1em;
				border-radius: 50px;
				font-size: 0.88rem;
				font-weight: 700;
				text-decoration: none;
				transition: opacity 0.15s, transform 0.15s;
			}
			.affiliate-link:hover {
				opacity: 0.85;
				transform: translateY(-1px);
			}
			.affiliate-link.booking { background: #003580; color: white; }
			.affiliate-link.viator  { background: #00af87; color: white; }
			.affiliate-link.amazon  { background: #ff9900; color: #111; }
			.affiliate-link.youtube { background: #ff0000; color: white; }

			@media (max-width: 640px) {
				.post-hero { height: 55vw; min-height: 220px; }
				.post-hero-text { padding: 1.2rem 1.2rem; }
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				{heroImage ? (
					<div class="post-hero">
						<Image width={1400} height={800} src={heroImage} alt={title} />
						<div class="post-hero-overlay">
							<div class="post-hero-text">
								<div class="date">
									<FormattedDate date={pubDate} />
									{updatedDate && <> · Updated <FormattedDate date={updatedDate} /></>}
								</div>
								<h1>{title}</h1>
							</div>
						</div>
					</div>
				) : (
					<div class="post-title-plain">
						<div class="date"><FormattedDate date={pubDate} /></div>
						<h1>{title}</h1>
					</div>
				)}

				<div class="prose">
					<slot />
				</div>

				{affiliateLinks && (
					<div class="affiliate-box">
						<h3>Plan your trip</h3>
						<div class="affiliate-links">
							{affiliateLinks.booking && (
								<a href={affiliateLinks.booking} target="_blank" rel="nofollow noopener" class="affiliate-link booking">🏨 Hotels</a>
							)}
							{affiliateLinks.viator && (
								<a href={affiliateLinks.viator} target="_blank" rel="nofollow noopener" class="affiliate-link viator">🎟️ Book a tour</a>
							)}
							{affiliateLinks.amazon && (
								<a href={affiliateLinks.amazon} target="_blank" rel="nofollow noopener" class="affiliate-link amazon">📦 Amazon</a>
							)}
							{affiliateLinks.youtubeVideo && (
								<a href={affiliateLinks.youtubeVideo} target="_blank" rel="noopener" class="affiliate-link youtube">▶ Watch</a>
							)}
						</div>
					</div>
				)}
			</article>
		</main>
		<Footer />
	</body>
</html>
