---
import {Image} from 'astro:assets';
import {getCollection,type CollectionEntry} from 'astro:content';
import SiteLayout from './SiteLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import PostCard from '../components/PostCard.astro';
import {meta,published,type EditorialData} from '../lib/editorial';
import {destinations} from '../data/destinations';
type Props=CollectionEntry<'blog'>['data'] & EditorialData;
const {title,description,pubDate,updatedDate,heroImage,affiliateLinks,heroAlt,destination,imageCredit,imageSource}=Astro.props;
const island=destinations.find(d=>d.id===destination);
const posts=(await getCollection('blog')).filter(p=>published(p)&&decodeURI(`/blog/${p.id}/`)!==decodeURI(Astro.url.pathname));
const related=posts.sort((a,b)=>Number(meta(b).destination===destination)-Number(meta(a).destination===destination)||b.data.pubDate.valueOf()-a.data.pubDate.valueOf()).slice(0,3);
---
<SiteLayout title={`${title} — Just Okinawa`} description={description}><article><header class="article-header"><a class="eyebrow" href={island?`/islands/${island.id}/`:'/blog/'}>← {island?.name??'THE ISLAND JOURNAL'}</a><h1>{title}</h1><p>{description}</p><div class="article-date"><FormattedDate date={pubDate}/>{updatedDate&&<> · Updated <FormattedDate date={updatedDate}/></>}</div></header>{heroImage&&<figure class="article-image"><Image src={heroImage} width={1600} height={1000} alt={heroAlt??title} loading="eager" fetchpriority="high"/>{imageCredit&&<figcaption>Photo: {imageSource?<a href={imageSource} target="_blank" rel="noopener noreferrer">{imageCredit}</a>:imageCredit}</figcaption>}</figure>}<div class="article-body"><div class="prose"><slot/></div></div>{affiliateLinks&&(affiliateLinks.booking||affiliateLinks.viator||affiliateLinks.amazon||affiliateLinks.youtubeVideo)&&<aside class="affiliate-box"><span class="eyebrow">MAKE IT YOURS</span><h2>Plan your trip.</h2><div class="affiliate-links">{affiliateLinks.booking&&<a class="button" href={affiliateLinks.booking} target="_blank" rel="sponsored nofollow noopener noreferrer">Hotels ↗</a>}{affiliateLinks.viator&&<a class="button" href={affiliateLinks.viator} target="_blank" rel="sponsored nofollow noopener noreferrer">Book a tour ↗</a>}{affiliateLinks.amazon&&<a class="button" href={affiliateLinks.amazon} target="_blank" rel="sponsored nofollow noopener noreferrer">Amazon ↗</a>}{affiliateLinks.youtubeVideo&&<a class="button" href={affiliateLinks.youtubeVideo} target="_blank" rel="noopener noreferrer">Watch ↗</a>}</div>{(affiliateLinks.booking||affiliateLinks.viator||affiliateLinks.amazon)&&<p>Some links may be affiliate links. We may earn a commission at no additional cost to you.</p>}</aside>}</article><section class="wrap related"><h2>A little more <em>island time.</em></h2><div class="post-grid">{related.map(post=><PostCard post={post}/>)}</div><div class="reading-back"><a class="text-link" href="/blog/">Back to the journal ↗</a></div></section></SiteLayout>
