---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
interface Props {title:string;description:string;overlay?:boolean;}
const {title,description,overlay=false}=Astro.props;
---
<!doctype html><html lang="en"><head><BaseHead title={title} description={description}/></head><body><Header overlay={overlay}/><main id="main"><slot/></main><Footer/></body></html>
